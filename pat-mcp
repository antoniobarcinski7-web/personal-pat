#!/usr/bin/env bash
# Servidor MCP do PAT, para o Claude Desktop chamar.
#
# Wrapper pelo mesmo motivo do `./pat`: o console script instalado pelo `uv`
# nao funciona no Python 3.14 desta maquina, e o Claude Desktop precisa de um
# comando absoluto que funcione sem shell interativo - ele nao le o `.zshrc`,
# entao alias nao serve aqui.
#
# `exec` importa: o Claude Desktop conversa com o processo por stdin/stdout, e
# um bash intermediario no meio quebraria o transporte.
set -euo pipefail
RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$RAIZ"
# O `uv` pelo caminho ABSOLUTO, e nao pelo PATH.
#
# O Claude Desktop nao abre shell de login: ele nao le `.zshrc` nem `.zprofile`,
# entao o PATH que ele passa nao tem o Homebrew. Um `exec uv` simples aqui
# falha com "uv: not found" - e falha DENTRO do transporte MCP, onde a
# mensagem nao chega a lugar nenhum que alguem leia. O servidor apareceria
# como "desconectado", sem causa.
UV="/opt/homebrew/bin/uv"
if [ ! -x "$UV" ]; then
  # Fallback para quem instalou noutro lugar. A mensagem vai para stderr, que
  # o Claude Desktop registra no log do servidor.
  UV="$(command -v uv || true)"
  if [ -z "$UV" ]; then
    echo "pat-mcp: nao encontrei o \`uv\`. Instale-o ou ajuste UV neste arquivo." >&2
    exit 1
  fi
fi
PYTHONPATH=src exec "$UV" run --locked python -m pat.mcp_server
